    <style>
        /* The two fonts and the painting below are inlined as data, so the page is one file and
           `pygbag --archive` needs nothing next to it. To change one, decode it, edit it, encode it back.
           Start page. Design: docs/design/gdd/10-ui.md, Start page. Tokens first, then the stage: the
           game window's shape (856 x 518) with the menu's painting, placed where the canvas shows,
           so the menu appears on the same picture. */
        :root {
            --ink: #05040f;
            --text: #d8c8ff;
            --dim: #8f86b8;
            --violet: #9d6bff;
            --cyan: #8be9ff;
            --gold: #ffd166;
            --mono: "Share Tech Mono", ui-monospace, "Courier New", monospace;
            --display: "Exo 2", "Arial Black", sans-serif;
        }
        @font-face {
            font-family: "Exo 2";
            font-style: italic;
            font-weight: 900;
            src: url("data:font/woff2;base64,") format("woff2");
            font-display: swap;
        }
        @font-face {
            font-family: "Share Tech Mono";
            src: url("data:font/ttf;base64,") format("truetype");
            font-display: swap;
        }

        #start {
            position: fixed;
            inset: 0;
            z-index: 999999;
            background: var(--ink);
            transition: opacity 0.7s ease 0.35s, visibility 0s linear 1.05s;
        }
        body.playing #start { opacity: 0; visibility: hidden; pointer-events: none; }

        #stage {
            position: absolute;
            left: 50%;
            top: 50%;
            width: min(100vw, calc(100vh * 856 / 518));
            aspect-ratio: 856 / 518;
            transform: translate(-50%, -50%);
            overflow: hidden;
            container-type: inline-size;
            background: var(--ink) url("data:image/webp;base64,") left bottom / cover no-repeat;
        }
        #vig {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at 62% 36%, transparent 28%, rgba(3, 2, 14, 0.7) 100%);
        }

        /* The name is plain SVG text with a gradient fill. No filter, no clipped background and no
           moving gradient: those made some browsers leave a stale second copy of the lettering.
           The glow is a soft light behind the name, not a copy of it. */
        #glow {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 36% 17% at 50% 22%, rgba(157, 107, 255, 0.34), transparent 100%),
                radial-gradient(ellipse 22% 8% at 50% 36%, rgba(139, 233, 255, 0.08), transparent 100%);
            animation: fade 1.4s ease both;
        }
        #logo {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            margin: 0;
            animation: fade 1.4s ease 0.15s both;
        }
        #logo text {
            font-family: var(--display);
            font-style: italic;
            font-weight: 900;
            text-anchor: middle;
        }
        #logo .name { font-size: 87.3px; letter-spacing: 5.2px; }
        #logo .ace { font-size: 56.5px; letter-spacing: 50.8px; }
        #rule {
            position: absolute;
            left: 50%;
            top: 47%;
            width: 0;
            height: 1px;
            transform: translateX(-50%);
            background: linear-gradient(90deg, transparent, var(--cyan), transparent);
            animation: rule 1.6s ease 0.6s forwards;
        }
        @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
        @keyframes rule { to { width: 54%; } }

        #dock {
            position: absolute;
            left: 27%;
            width: 46%;
            bottom: 10%;
            text-align: center;
            font-family: var(--mono);
            color: var(--dim);
            letter-spacing: 0.42em;
            font-size: clamp(11px, 2.8cqw, 18px);
        }
        /* pythons.js writes its download numbers here. The page reads them for its own bar. */
        #transfer { display: none !important; }
        #bar {
            position: relative;
            width: 100%;
            height: max(4px, 0.7cqw);
            margin-top: 1.4cqw;
            border-radius: 99px;
            overflow: hidden;
            background: rgba(139, 233, 255, 0.16);
            box-shadow: 0 0 1.4cqw rgba(157, 107, 255, 0.3);
            transition: opacity 0.5s ease;
        }
        #bar.done { opacity: 0; }
        #barfill {
            display: block;
            height: 100%;
            width: 0;
            border-radius: 99px;
            background: linear-gradient(90deg, var(--violet), var(--cyan));
            transition: width 0.2s linear;
        }

        #infobox {
            position: static;
            background: none;
            padding: 0;
            font-weight: normal;
            color: var(--dim);
            z-index: auto;
        }
        #infobox.ready {
            color: #f1ebff;
            cursor: pointer;
            font-size: clamp(12px, 3.2cqw, 28px);
            text-shadow:
                0 0 0.5cqw rgba(139, 233, 255, 0.95),
                0 0 1.6cqw rgba(139, 233, 255, 0.8),
                0 0 3.4cqw rgba(157, 107, 255, 0.9);
            animation: pulse 1.8s ease-in-out infinite;
        }
        @keyframes pulse { 50% { opacity: 0.55; } }

        @media (prefers-reduced-motion: reduce) {
            #glow, #logo, #rule, #infobox.ready { animation: none; }
            #rule { width: 54%; }
            #barfill { transition: none; }
        }

        div.emscripten { text-align: center; }
        div.emscripten_border { border: 1px solid black; }
        div.thick_border { border: 4px solid black; }

        /* the canvas *must not* have any border or padding, or mouse coords will be wrong */
        /* average size of droid screen 470dp x 320dp  */
        canvas.emscripten {
            border: 0px none;
            background-color: transparent;
            width: 100%;
            height: 100%;
            z-index: 5;

            padding: 0;
