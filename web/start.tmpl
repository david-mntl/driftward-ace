    archive : "{{cookiecutter.archive}}",
    gui_debug : 2,
    cdn : "{{cookiecutter.cdn}}",
    autorun : {{cookiecutter.autorun}},
    PYBUILD : "{{cookiecutter.PYBUILD}}",
    fb_ar   :  1.77,
    fb_width : "{{cookiecutter.width}}",
    fb_height : "{{cookiecutter.height}}"
}

function show_infobox() {
    infobox.style.display = "block";
}

// The start page. The loader code in the Python part above calls runtime() when the Python
// runtime is up, ready() when the game is loaded and waiting for the player, and leave() once
// the game runs. A click or a key press is the gesture the browser needs before it allows sound.
//
// The loading bar adds up what the page can really measure: the runtime download (pythons.js
// fills the hidden #progress), the game package download (fetched here, so its bytes can be
// counted; the browser keeps the file, so the loader finds it already there), then the unpacking,
// which has no numbers and is estimated. After the press the game's own start-up has no numbers
// either, so that bar is an estimate too.
window.startpage = (() => {
    const WEIGHT = { runtime: 0.55, pack: 0.35 };
    const state = { phase: "load", runtime: 0, pack: 0, shown: 0, since: performance.now() };
    let bar, fill;

    function paint(value) {
        state.shown = Math.max(state.shown, Math.min(value, 1));
        fill.style.width = (state.shown * 100).toFixed(1) + "%";
        bar.setAttribute("aria-valuenow", Math.round(state.shown * 100));
    }

    function tick() {
        const seconds = (performance.now() - state.since) / 1000;
        if (state.phase === "load") {
            const total = Math.max(progress.max, 1);
            state.runtime = Math.max(state.runtime, Math.min(progress.value / total, 1));
            const known = state.runtime * WEIGHT.runtime + state.pack * WEIGHT.pack;
            const unpack = state.runtime === 1 && state.pack === 1 ? 0.1 * (1 - Math.exp(-seconds / 2.5)) : 0;
            const value = known + unpack;
            paint(value);
            infobox.textContent = "LOADING " + Math.round(state.shown * 100) + "%";
        } else if (state.phase === "start") {
            paint(0.95 * (1 - Math.exp(-seconds / 3)));
        }
        if (state.phase !== "done") requestAnimationFrame(tick);
    }

    async function fetchPack() {
        const name = config.archive + (location.host.indexOf(".itch.zone") > 0 ? ".apk" : ".tar.gz");
        try {
            const response = await fetch(name);
            const length = Number(response.headers.get("content-length")) || 0;
            const reader = response.body.getReader();
            let got = 0;
            for (;;) {
                const { done, value } = await reader.read();
                if (done) break;
                got += value.length;
                if (length) state.pack = Math.min(got / length, 0.99);
            }
        } catch (error) {
            console.warn("start page: package prefetch failed, the bar will estimate", error);
        }
        state.pack = 1;
    }

    document.addEventListener("DOMContentLoaded", () => {
        bar = document.getElementById("bar");
        fill = document.getElementById("barfill");
        requestAnimationFrame(tick);
    });
    fetchPack();

    return {
        runtime() { state.runtime = 1; },
        ready() {
            state.phase = "ready";
            paint(1);
            bar.classList.add("done");
            infobox.classList.add("ready");
            const go = () => {
                window.removeEventListener("pointerdown", go);
                window.removeEventListener("keydown", go);
                infobox.classList.remove("ready");
                infobox.textContent = "STARTING";
                state.phase = "start";
                state.since = performance.now();
                state.shown = 0;
                bar.classList.remove("done");
                requestAnimationFrame(tick);
                try {
                    new Audio(config.cdn + "empty.ogg").play().then(() => { MM.UME = true; }).catch(() => {});
                } catch (error) {
                    console.warn("start page: audio unlock failed", error);
                }
                canvas.focus();
            };
            window.addEventListener("pointerdown", go);
            window.addEventListener("keydown", go);
        },
        leave() {
            state.phase = "done";
            paint(1);
            setTimeout(() => document.body.classList.add("playing"), 400);
            setTimeout(() => window.startsky.stop(), 1600);
        }
    };
})();

</script>

<script>
// The start page's sky: a black hole drawn live, with the player's ship circling it. Design:
// docs/design/gdd/10-ui.md, start_sky. Every number is in SKY below. The scene draws in the stage's
// own 856 x 518 units and scales with it. It stops for good once the game runs.
window.startsky = (() => {
    const SKY = {
        hole: {
            cx: 428, cy: 332,          // center, in stage units
            r: 54,                      // the dark center's radius
            inner: 70, outer: 228,      // the glowing disk's inner and outer edge
            tilt: 0.2,                  // how flat the disk looks (1 = seen face on)
            rot: -0.07,                 // the disk's lean, in radians
            lens: 0.4,                  // how far the bent light arcs above the dark center
            specks: 1600,               // light specks in the disk
            spin: 0.55,                 // the disk's turn speed at its inner edge, radians per second
            rivers: 140,                // specks spiralling in from outside
            seed: 11,
        },
        orbit: {
            seconds: 11,                // one lap of the ship
            radius: 300,                // in the disk's plane
            tilt: 0.17, lift: -6,       // the lap's flatness, and how far above the disk it flies
            size: 0.95, depthSize: 0.3, // ship scale at the sides, and how much nearer makes it bigger
            trail: 34,                  // trail length, in frames
        },
        stars: 760, twinkles: 22, starSeed: 101,
        colors: ["#fff6e0", "#ffd166", "#ff9e5e", "#ff5fd2", "#a46bff", "#8be9ff"],
        maxPixelRatio: 2,
        stillTime: 3.2,                 // the moment shown when the browser asks for reduced motion
    };
    const W = 856, H = 518, TAU = Math.PI * 2;
    const HULL = new Image();
    HULL.src = "data:image/png;base64,";
    const FLAME = new Image();
    FLAME.src = "data:image/png;base64,";

    function rng(seed) {
        return () => {
            seed = (seed + 0x6d2b79f5) | 0;
            let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
    }

    // One soft dot per color, drawn once and stamped many times.
    const DOTS = SKY.colors.map((c) => {
        const s = document.createElement("canvas");
        s.width = s.height = 32;
        const g = s.getContext("2d");
        const gr = g.createRadialGradient(16, 16, 0, 16, 16, 16);
        gr.addColorStop(0, c);
        gr.addColorStop(0.22, c + "cc");
        gr.addColorStop(1, c + "00");
        g.fillStyle = gr;
        g.fillRect(0, 0, 32, 32);
        return s;
    });

    const h = SKY.hole;
    const cosR = Math.cos(h.rot), sinR = Math.sin(h.rot);
    const place = (x, y) => [h.cx + x * cosR - y * sinR, h.cy + x * sinR + y * cosR];

    // Disk specks: radius, start angle, turn speed, size, brightness, color.
    const R = rng(h.seed), n = h.specks;
    const rho = new Float32Array(n), th0 = new Float32Array(n), om = new Float32Array(n);
    const sz = new Float32Array(n), al = new Float32Array(n), ci = new Uint8Array(n);
    for (let i = 0; i < n; i++) {
        const f = Math.pow(R(), 1.7);
        rho[i] = h.inner + f * (h.outer - h.inner);
        th0[i] = R() * TAU;
        om[i] = h.spin * Math.pow(h.inner / rho[i], 1.5) * (0.9 + 0.2 * R());
        ci[i] = f < 0.1 ? 0 : f < 0.28 ? 1 : f < 0.48 ? 2 : f < 0.7 ? 3 : 4;
        if (R() < 0.035) ci[i] = 5;
        sz[i] = (1.6 + R() * 3.6) * (1.25 - f * 0.55);
        al[i] = Math.pow(1 - f, 0.8) * (0.3 + 0.7 * R());
    }
    const m = h.rivers;
    const fa = new Float32Array(m), fr = new Float32Array(m), fo = new Float32Array(m);
    const fp = new Float32Array(m), fs = new Float32Array(m), fc = new Uint8Array(m);
    for (let i = 0; i < m; i++) {
        fa[i] = R() * TAU;
        fr[i] = h.outer * (1.25 + R() * 1.6);
        fo[i] = R();
        fp[i] = 7 + R() * 7;
        fs[i] = 1.4 + R() * 2.2;
        fc[i] = [3, 4, 4, 5][Math.floor(R() * 4)];
    }

    function ring(ctx, r0, r1, half, yScale, stops) {
        ctx.save();
        ctx.translate(h.cx, h.cy);
        ctx.rotate(h.rot);
        const big = r1 * 2;
        ctx.beginPath();
        if (half < 0) ctx.rect(-big, -big, big * 2, big); else ctx.rect(-big, 0, big * 2, big);
        ctx.clip();
        ctx.scale(1, yScale);
        const g = ctx.createRadialGradient(0, 0, r0, 0, 0, r1);
        stops.forEach(([o, c]) => g.addColorStop(o, c));
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(0, 0, r1, 0, TAU);
        ctx.arc(0, 0, r0, 0, TAU, true);
        ctx.fill("evenodd");
        ctx.restore();
    }

    function disk(ctx, half) {
        ring(ctx, h.inner * 0.96, h.outer, half, h.tilt, [
            [0, "rgba(255,246,224,0.85)"], [0.07, "rgba(255,209,102,0.5)"], [0.28, "rgba(255,110,150,0.25)"],
            [0.6, "rgba(157,107,255,0.1)"], [1, "rgba(157,107,255,0)"],
        ]);
    }

    // The far half of the disk (half -1) shows above the center, the near half (1) below it.
    // The side turning toward the viewer is brighter.
    function specks(ctx, t, half) {
        for (let i = 0; i < n; i++) {
            const th = th0[i] + om[i] * t;
            const z = Math.sin(th);
            if ((z < 0) !== (half < 0)) continue;
            const beam = 1 + 0.7 * Math.cos(th);
            const s = sz[i] * (0.75 + 0.25 * beam);
            const [sx, sy] = place(rho[i] * Math.cos(th), rho[i] * z * h.tilt);
            ctx.globalAlpha = Math.min(1, al[i] * beam);
            ctx.drawImage(DOTS[ci[i]], sx - s, sy - s * 0.6, s * 2, s * 1.2);
        }
    }

    // Light from behind the hole, bent into an arc over the top and a thin one under the bottom.
    function bent(ctx, t) {
        for (let i = 0; i < n; i++) {
            const th = th0[i] + om[i] * t;
            const z = Math.sin(th), ux = Math.cos(th);
            const d = rho[i] - h.inner;
            const far = z < 0;
            const rad = far ? h.r * 1.1 + d * h.lens : h.r * 1.03 + d * 0.1;
            const [sx, sy] = place(rad * ux, (far ? -1 : 1) * rad * Math.sqrt(1 - ux * ux));
            const s = sz[i] * 0.8;
            ctx.globalAlpha = Math.min(1, al[i] * (1 + 0.7 * ux) * (far ? 0.55 : 0.22));
            ctx.drawImage(DOTS[ci[i]], sx - s, sy - s, s * 2, s * 2);
        }
    }

    function rivers(ctx, t, half) {
        for (let i = 0; i < m; i++) {
            const p = (t / fp[i] + fo[i]) % 1;
            const rad = h.r * 1.08 + (fr[i] - h.r * 1.08) * Math.pow(1 - p, 1.4);
            const ang = fa[i] + p * 2.8;
            const z = Math.sin(ang);
            if ((z < 0) !== (half < 0)) continue;
            const [sx, sy] = place(rad * Math.cos(ang), rad * z * h.tilt);
            ctx.globalAlpha = Math.pow(Math.sin(p * Math.PI), 1.5) * 0.7;
            ctx.drawImage(DOTS[fc[i]], sx - fs[i], sy - fs[i], fs[i] * 2, fs[i] * 2);
        }
    }

    function holeBack(ctx, t) {
        ctx.save();
        ctx.globalCompositeOperation = "lighter";
        const g = ctx.createRadialGradient(h.cx, h.cy, h.r * 0.9, h.cx, h.cy, h.outer * 1.3);
        g.addColorStop(0, "rgba(255,150,200,0.2)");
        g.addColorStop(0.3, "rgba(157,107,255,0.11)");
        g.addColorStop(1, "rgba(157,107,255,0)");
        ctx.fillStyle = g;
        ctx.fillRect(h.cx - h.outer * 1.3, h.cy - h.outer * 1.3, h.outer * 2.6, h.outer * 2.6);
        rivers(ctx, t, -1);
        disk(ctx, -1);
        specks(ctx, t, -1);
        ctx.restore();
    }

    function holeCenter(ctx, t) {
        ctx.save();
        ctx.fillStyle = "#010007";
        ctx.beginPath();
        ctx.arc(h.cx, h.cy, h.r, 0, TAU);
        ctx.fill();
        ctx.globalCompositeOperation = "lighter";
        ring(ctx, h.r * 1.05, h.r * 1.1 + (h.outer - h.inner) * h.lens, -1, 1, [
            [0, "rgba(255,246,224,0.7)"], [0.08, "rgba(255,209,102,0.42)"], [0.35, "rgba(255,95,190,0.18)"], [1, "rgba(157,107,255,0)"],
        ]);
        bent(ctx, t);
        ctx.globalAlpha = 1;
        const g = ctx.createRadialGradient(h.cx, h.cy, h.r * 0.97, h.cx, h.cy, h.r * 1.3);
        g.addColorStop(0, "rgba(255,225,190,0)");
        g.addColorStop(0.08, "rgba(255,225,190,0.5)");
        g.addColorStop(0.3, "rgba(255,140,200,0.12)");
        g.addColorStop(1, "rgba(157,107,255,0)");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(h.cx, h.cy, h.r * 1.3, 0, TAU);
        ctx.fill();
        ctx.strokeStyle = "rgba(255,244,230,0.9)";
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.arc(h.cx, h.cy, h.r * 1.015, 0, TAU);
        ctx.stroke();
        ctx.restore();
    }

    function holeFront(ctx, t) {
        ctx.save();
        ctx.globalCompositeOperation = "lighter";
        disk(ctx, 1);
        specks(ctx, t, 1);
        rivers(ctx, t, 1);
        ctx.restore();
    }

    // Stars, drawn once. Those near the hole are pushed outward, the way bent light shows them.
    function starfield() {
        const c = document.createElement("canvas");
        c.width = W * 2;
        c.height = H * 2;
        const g = c.getContext("2d");
        g.scale(2, 2);
        const bg = g.createLinearGradient(0, 0, 0, H);
        bg.addColorStop(0, "#080619");
        bg.addColorStop(1, "#04030b");
        g.fillStyle = bg;
        g.fillRect(0, 0, W, H);
        const S = rng(SKY.starSeed);
        const neb = ["rgba(157,107,255,0.07)", "rgba(255,95,210,0.045)", "rgba(80,120,255,0.05)", "rgba(139,233,255,0.03)"];
        for (let i = 0; i < 7; i++) {
            const x = S() * W, y = S() * H, rad = 160 + S() * 260;
            const gr = g.createRadialGradient(x, y, 0, x, y, rad);
            gr.addColorStop(0, neb[i % neb.length]);
            gr.addColorStop(1, "rgba(0,0,0,0)");
            g.fillStyle = gr;
            g.fillRect(x - rad, y - rad, rad * 2, rad * 2);
        }
        const tints = ["#ffffff", "#ffffff", "#ffffff", "#dcd0ff", "#bfefff", "#ffe6b0"];
        for (let i = 0; i < SKY.stars; i++) {
            let x = S() * W, y = S() * H;
            const dx = x - h.cx, dy = y - h.cy, d = Math.hypot(dx, dy);
            if (d < h.r * 1.12) continue;
            const k = (d + Math.pow(h.r * 1.6, 2) / d) / d;
            x = h.cx + dx * k;
            y = h.cy + dy * k;
            g.globalAlpha = 0.25 + S() * 0.75;
            g.fillStyle = tints[Math.floor(S() * tints.length)];
            g.beginPath();
            g.arc(x, y, 0.35 + Math.pow(S(), 4) * 1.5, 0, TAU);
            g.fill();
        }
        const tw = [];
        while (tw.length < SKY.twinkles) {
            const x = S() * W, y = S() * H;
            if (Math.hypot(x - h.cx, y - h.cy) < h.outer * 0.9) continue;
            tw.push({ x, y, w: 0.6 + S() * 1.6, ph: S() * TAU, s: 2 + S() * 3 });
        }
        return [c, tw];
    }

    function twinkle(ctx, list, t) {
        ctx.save();
        ctx.globalCompositeOperation = "lighter";
        ctx.strokeStyle = "#e9e2ff";
        ctx.lineWidth = 0.7;
        for (const p of list) {
            const a = Math.pow(0.5 + 0.5 * Math.sin(t * p.w + p.ph), 3);
            if (a < 0.05) continue;
            ctx.globalAlpha = a * 0.8;
            ctx.beginPath();
            ctx.moveTo(p.x - p.s, p.y);
            ctx.lineTo(p.x + p.s, p.y);
            ctx.moveTo(p.x, p.y - p.s);
            ctx.lineTo(p.x, p.y + p.s);
            ctx.stroke();
        }
        ctx.restore();
    }

    // The ship's lap. Depth runs from -1 (behind the hole) to 1 (in front of it).
    const o = SKY.orbit;
    function lap(t) {
        const ph = (t / o.seconds) * TAU;
        return [...place(o.radius * Math.cos(ph), o.radius * Math.sin(ph) * o.tilt + o.lift), Math.sin(ph)];
    }

    const trail = [];
    function drawTrail(ctx, scale) {
        const k = trail.length / 2;
        if (k < 2) return;
        ctx.save();
        ctx.globalCompositeOperation = "lighter";
        ctx.lineCap = "round";
        for (let i = 1; i < k; i++) {
            const f = i / k;
            ctx.strokeStyle = `rgba(139,233,255,${(f * f * 0.55).toFixed(3)})`;
            ctx.lineWidth = (0.6 + f * 3.2) * scale;
            ctx.beginPath();
            ctx.moveTo(trail[i * 2 - 2], trail[i * 2 - 1]);
            ctx.lineTo(trail[i * 2], trail[i * 2 + 1]);
            ctx.stroke();
        }
        ctx.restore();
    }

    // The ship in the game sprite's own 48 x 64 frame: flame frames from ship_flame.png, the hull
    // from its larger source picture so it stays sharp on big screens.
    function drawShip(ctx, x, y, ang, sc, t, alpha) {
        if (!HULL.complete || !FLAME.complete) return;
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(ang);
        ctx.scale(sc, sc);
        ctx.globalAlpha = alpha;
        ctx.globalCompositeOperation = "lighter";
        const g = ctx.createRadialGradient(0, 24, 0, 0, 24, 30);
        g.addColorStop(0, "rgba(139,233,255,0.6)");
        g.addColorStop(0.4, "rgba(80,140,255,0.22)");
        g.addColorStop(1, "rgba(80,140,255,0)");
        ctx.fillStyle = g;
        ctx.fillRect(-30, -6, 60, 60);
        const f = Math.floor(t * 18) % 2;
        ctx.drawImage(FLAME, f * 48, 0, 48, 64, -24, -31, 48, 64);
        ctx.drawImage(FLAME, f * 48, 40, 48, 24, -24, 9, 48, 34);
        ctx.globalCompositeOperation = "source-over";
        ctx.drawImage(HULL, -22.6, -22, 46.1, 46.1);
        ctx.restore();
    }

    let canvas, ctx, sky, tw, raf = 0, t0 = 0, stopped = false;

    function fit() {
        const dpr = Math.min(window.devicePixelRatio || 1, SKY.maxPixelRatio);
        const r = canvas.getBoundingClientRect();
        canvas.width = Math.max(1, Math.round(r.width * dpr));
        canvas.height = Math.max(1, Math.round(r.height * dpr));
    }

    function render(t) {
        ctx.setTransform(canvas.width / W, 0, 0, canvas.height / H, 0, 0);
        ctx.globalCompositeOperation = "source-over";
        ctx.globalAlpha = 1;
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        ctx.drawImage(sky, 0, 0, W, H);
        twinkle(ctx, tw, t);

        const [x, y, depth] = lap(t), [x1, y1] = lap(t + 0.01);
        const ang = Math.atan2(y1 - y, x1 - x) + Math.PI / 2;
        const sc = o.size + o.depthSize * depth;
        const alpha = 0.7 + 0.3 * (depth + 1) / 2;
        trail.push(x - Math.sin(ang) * 18 * sc, y + Math.cos(ang) * 18 * sc);
        if (trail.length > o.trail * 2) trail.splice(0, 2);

        holeBack(ctx, t);
        if (depth < 0) { drawTrail(ctx, sc); drawShip(ctx, x, y, ang, sc, t, alpha); }
        holeCenter(ctx, t);
        holeFront(ctx, t);
        if (depth >= 0) { drawTrail(ctx, sc); drawShip(ctx, x, y, ang, sc, t, alpha); }
    }

    function frame(now) {
        if (stopped) return;
        render((now - t0) / 1000);
        raf = requestAnimationFrame(frame);
    }

    document.addEventListener("DOMContentLoaded", () => {
        canvas = document.getElementById("sky");
        ctx = canvas.getContext("2d");
        [sky, tw] = starfield();
        fit();
        new ResizeObserver(fit).observe(canvas);
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
            const still = () => { if (!stopped) render(SKY.stillTime); };
            still();
            Promise.all([HULL, FLAME].map((im) => im.decode().catch(() => {}))).then(still);
            new ResizeObserver(still).observe(canvas);
            return;
        }
        t0 = performance.now();
        raf = requestAnimationFrame(frame);
    });

    return {
        stop() {
            stopped = true;
            cancelAnimationFrame(raf);
        },
    };
})();
</script>


