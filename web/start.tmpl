    fb_width : "{{cookiecutter.width}}",
    fb_height : "{{cookiecutter.height}}"
}

function show_infobox() {
    infobox.style.display = "block";
}

// The start page. The loader code in the Python part above calls runtime() when the Python
// runtime is up, ready() when the game is loaded and waiting for the player, and leave() once
// the game runs. A click or a key press is the gesture the browser needs before it allows sound.
//
// The loading bar adds up what the page can really measure: the runtime download (pythons.js
// fills the hidden #progress), the game package download (fetched here, so its bytes can be
// counted; the browser keeps the file, so the loader finds it already there), then the unpacking,
// which has no numbers and is estimated. After the press the game's own start-up has no numbers
// either, so that bar is an estimate too.
window.startpage = (() => {
    const WEIGHT = { runtime: 0.55, pack: 0.35 };
    const state = { phase: "load", runtime: 0, pack: 0, shown: 0, since: performance.now() };
    let bar, fill;

    function paint(value) {
        state.shown = Math.max(state.shown, Math.min(value, 1));
        fill.style.width = (state.shown * 100).toFixed(1) + "%";
        bar.setAttribute("aria-valuenow", Math.round(state.shown * 100));
    }

    function tick() {
        const seconds = (performance.now() - state.since) / 1000;
        if (state.phase === "load") {
            const total = Math.max(progress.max, 1);
            state.runtime = Math.max(state.runtime, Math.min(progress.value / total, 1));
            const known = state.runtime * WEIGHT.runtime + state.pack * WEIGHT.pack;
            const unpack = state.runtime === 1 && state.pack === 1 ? 0.1 * (1 - Math.exp(-seconds / 2.5)) : 0;
            const value = known + unpack;
            paint(value);
            infobox.textContent = "LOADING " + Math.round(state.shown * 100) + "%";
        } else if (state.phase === "start") {
            paint(0.95 * (1 - Math.exp(-seconds / 3)));
        }
        if (state.phase !== "done") requestAnimationFrame(tick);
    }

    async function fetchPack() {
        const name = config.archive + (location.host.indexOf(".itch.zone") > 0 ? ".apk" : ".tar.gz");
        try {
            const response = await fetch(name);
            const length = Number(response.headers.get("content-length")) || 0;
            const reader = response.body.getReader();
            let got = 0;
            for (;;) {
                const { done, value } = await reader.read();
                if (done) break;
                got += value.length;
                if (length) state.pack = Math.min(got / length, 0.99);
            }
        } catch (error) {
            console.warn("start page: package prefetch failed, the bar will estimate", error);
        }
        state.pack = 1;
    }

    document.addEventListener("DOMContentLoaded", () => {
        bar = document.getElementById("bar");
        fill = document.getElementById("barfill");
        requestAnimationFrame(tick);
    });
    fetchPack();

    return {
        runtime() { state.runtime = 1; },
        ready() {
            state.phase = "ready";
            paint(1);
            bar.classList.add("done");
            infobox.classList.add("ready");
            const go = () => {
                window.removeEventListener("pointerdown", go);
                window.removeEventListener("keydown", go);
                infobox.classList.remove("ready");
                infobox.textContent = "STARTING";
                state.phase = "start";
                state.since = performance.now();
                state.shown = 0;
                bar.classList.remove("done");
                requestAnimationFrame(tick);
                try {
                    new Audio(config.cdn + "empty.ogg").play().then(() => { MM.UME = true; }).catch(() => {});
                } catch (error) {
                    console.warn("start page: audio unlock failed", error);
                }
                canvas.focus();
            };
            window.addEventListener("pointerdown", go);
            window.addEventListener("keydown", go);
        },
        leave() {
            state.phase = "done";
            paint(1);
            setTimeout(() => document.body.classList.add("playing"), 400);
        }
    };
})();

</script>

